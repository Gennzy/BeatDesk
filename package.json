{
  "name": "beatdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-essentia.mjs && cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "node scripts/copy-essentia.mjs && cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "verify": "tsc --noEmit && eslint && vitest run",
    "verify:all": "pnpm verify",
    "cleanup:test": "node scripts/cleanup-test-accounts.mjs",
    "essentia:copy": "node scripts/copy-essentia.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.15.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "essentia.js": "^0.1.3",
    "jsdom": "^30.1.1",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.15.0"
}
