# Шаблон переменных окружения.
#
# Значения сюда не кладут: файл попадает в репозиторий. Реальные значения
# живут в .env.local, который закрыт правилом `.env*` в .gitignore.

# URL проекта Supabase: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Публикабельный ключ, попадает в браузер.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Служебный ключ. Только для сервера: им бот запоминает подключённый канал.
# Ключ утекал в чат, поэтому его стоит перевыпустить и обновить здесь.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=

# Подпись полезной нагрузки площадок.
PLATFORM_TOKEN_SECRET=

# OpenRouter: подсказки по названию, описанию и тегам бита.
OPENROUTER_API_KEY=

TELEGRAM_BOT_TOKEN=

# Секрет заголовка, которым Telegram подписывает вебхук.
TELEGRAM_WEBHOOK_SECRET=

# ID расширения для Chrome: без него публикация с площадки не включается.
NEXT_PUBLIC_BEATDESK_EXTENSION_ID=

# OAuth-клиент для публикации ролика на площадку.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Пока сервис в разработке. Значение "off" открывает сайт для всех.
BEATDESK_GATE=

# Адрес, которому заглушка «в разработке» не мешает.
BEATDESK_OWNER_EMAIL=
